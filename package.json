{
  "name": "jrjs",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "license": "MIT",
  "description": "jrjs library modules",
  "author": "JR <javier.rey.eu@gmail.com> (https://javierrey.github.io)",
  "workspaces": ["packages/*"],
  "main": "",
  "scripts": {
    "node:args": "node --preserve-symlinks --preserve-symlinks-main",
    "status": "echo CLEAN: && git clean -nfdX -e !.* -e !**/_ignore/ -e !**/_ignore/** && echo NEW: && git ls-files -o --exclude-standard",
    "clean": "git clean -fdX -e !.* -e !**/_ignore/ -e !**/_ignore/**",
    "clean:install": "npm run clean && npm i",
    "format:main": "npx eslint packages/main",
    "sync-source:main": "node packages/utils/drive/builder/sync-source.js --method=symlink --orig=packages --dest=packages/main --view-imports=1 --drive-imports=",
    "test:main": "npm -w packages/main run test",
    "stop:main": "npm run node:args packages/lib/drive/run.js stop main",
    "start:main": "npm run stop:main && npm run sync-source:main && npm run node:args packages/lib/drive/run.js start main \"{}\"",
    "format:lib": "npx eslint packages/lib",
    "test:lib": "npm -w packages/lib run test",
    "format:utils": "npx eslint packages/utils",
    "test:utils": "npm -w packages/utils run test",
    "format": "npm run format:lib && npm run format:utils && npm run format:main",
    "sync-source": "npm run sync-source:main",
    "test": "npm run test:lib && npm run test:utils && npm run test:main",
    "stop": "npm run stop:main",
    "start": "npm run start:main"
  },
  "dependencies": {},
  "devDependencies": {},
  "_ignore": {
    "jrjs@github": "github:javierrey/jrjs",
    "jrjs@http": "https://github.com/javierrey/jrjs",
    "jrjs@local": "file:../jrjs",
    "local_modules": {
      "dependencies": {},
      "devDependencies": {
        "@types/node": "./local_modules/dev_modules/@types/node",
        "electron": "./local_modules/dev_modules/electron_modules/electron",
        "minify": "./local_modules/dev_modules/min_modules/minify",
        "minify-xml": "./local_modules/dev_modules/min_modules/minify_xml"
      }
    }
  }
}
